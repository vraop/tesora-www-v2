---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import HarnessDiagram from "../components/HarnessDiagram.astro";
import Lifecycle from "../components/Lifecycle.astro";
import { u } from "../lib/url";

type Faq = { q: string; a: string };
const faqs: Faq[] = [
  {
    q: "Can we import our existing rating models?",
    a: "Yes. Upload your Excel raters directly and the system will rebuild, test, and deploy them for you. Formulas parsed, factor tables identified, a versioned model created. Existing logic is preserved exactly.",
  },
  {
    q: "What integrations do you support?",
    a: "Snowflake, Databricks, AWS, Microsoft Excel and Microsoft 365, Okta, and Guidewire are supported out of the box. REST API for anything else. If you use it, we can connect to it.",
  },
  {
    q: "How does role separation work for SOX?",
    a: "Three environments: dev (actuaries build), test (QA validates), prod (underwriters use). Different roles have different access. Actuaries cannot push directly to prod. Full audit trail of who promoted what and when.",
  },
  {
    q: "Do you train on our data?",
    a: "No. Zero data retention policies are in place with our model providers. Your data is not used for model training, ours or anyone else's.",
  },
  {
    q: "Is confidential data protected?",
    a: "Yes. Each customer is deployed as a single-tenant, bespoke environment your IT team controls. Your data does not share infrastructure with any other customer.",
  },
];

type Workflow = { num: string; agent?: string; title: string; body: string; outcomes: string[] };

const workflows: Workflow[] = [
  {
    num: "01",
    agent: "Data ingestion",
    title: "Don't fear messy data",
    body: "Loss runs, SOVs, exposure files, and rate manuals come in five formats from five carriers. Tesora reads any of them and hands back one normalized table with every value cited to the cell it came from.",
    outcomes: [
      "PDF, Excel, CSV, Word, email attachments",
      "Auto-classified and anomaly-checked",
      "Every value cites its source",
    ],
  },
  {
    num: "02",
    agent: "Rating agent",
    title: "Deploy raters quickly and securely",
    body: "Actuaries no longer wait on IT to deploy SOX-compliant rating tools. Source a rater from a SERFF filing or an internal Excel file, version every change, and ship to a callable pricing API. Author, reviewer, and approver are recorded as separate identities.",
    outcomes: [
      "Base rates, factors, ILFs, schedule mods",
      "Author, reviewer, approver as separate identities",
      "Deploy to GUI, API, or another Excel file",
    ],
  },
  {
    num: "03",
    agent: "Insight agent",
    title: "Run the analyses",
    body: "Trending, on-leveling, distribution fitting, GLMs, reserving. The math has been settled for decades. What slows the work is the assembly: finding the data, picking the right method, writing the memo. Tesora handles the assembly, and your work is now reproducible for years while you stay in charge of every decision.",
    outcomes: [
      "Trend, on-leveling, distribution fitting, GLMs",
      "Reserving (chain-ladder, BF, Cape Cod)",
    ],
  },
  {
    num: "04",
    agent: "Audit + delivery",
    title: "Audit and ship",
    body: "A specialist audit agent regrades every analysis against a host of proprietary actuarial tests before it reaches the user. Author, reviewer, and approver are recorded as separate identities. The audit trail follows the analysis through every promotion, so the work that lands on the pricing actuarial team's desk is reviewable from end to end.",
    outcomes: [
      "Author, reviewer, approver as separate identities",
      "Audit trail preserved across every promotion",
      "Every workflow lands as a reviewable artifact",
    ],
  },
];

---

<Layout
  title="Tesora Workbench"
  description="The Tesora Workbench is the surface chief actuaries use. The Tesora Harness is the framework underneath that orchestrates specialized agents and enforces citations, audit logs, and separation of duties."
  canonical="/agents"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/agents-loop.mp4")}
    headline="Agents designed for actuaries"
    deck="The Tesora Harness is a framework that lets actuarial agents run the assembly while citations, audit logs, and separation of duties stay enforced. Trained on the CAS syllabus and the Actuarial Standards of Practice."
    primaryCta={{ label: "Request a walkthrough", href: "https://cal.com/team/tesora/quick-chat" }}
    secondaryCta={{ label: "How it works", href: "#harness" }}
  />

  <Lifecycle />

  {/* Workbench / Harness positioning */}
  <section id="harness" class="border-b border-[var(--rule)] bg-[var(--bg)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
      <div class="grid md:grid-cols-12 gap-10 md:gap-14 items-start mb-12">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">How it works</p>
          <h2 class="font-semibold text-[2.5rem] md:text-[2.875rem] leading-[1.05] tracking-[-0.018em]">
            The Workbench, with a Harness underneath
          </h2>
        </div>
        <div class="md:col-span-7 grid gap-4">
          <p class="text-[1.1875rem] leading-[1.6] text-[var(--fg)]">
            <span class="font-semibold">The Workbench</span> is what the actuary uses. A chat window next to Excel, where you manipulate analyses, rating models, and workbooks the way you already work.
          </p>
          <p class="text-[1.1875rem] leading-[1.6] text-[var(--fg)]">
            <span class="font-semibold">The Harness</span> is the framework underneath. It orchestrates a fleet of specialized agents, enforces citations, keeps the audit log, and holds author, reviewer, and approver as separate identities. The agents are trained on the CAS syllabus and the Actuarial Standards of Practice. Every decision is yours.
          </p>
        </div>
      </div>

      <HarnessDiagram />
    </div>
  </section>

  {/* Why a workbench, not just chat */}
  <section id="different" class="border-b border-[var(--rule)] bg-[var(--bg)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
      <div class="grid md:grid-cols-12 gap-8">
        <div class="md:col-span-5 reveal">
          <p class="eyebrow mb-3">Built for actuaries</p>
          <h2 class="font-semibold text-[2.5rem] md:text-[2.875rem] leading-[1.05] tracking-[-0.018em]">
            Additive to the AI tools your team already uses
          </h2>
          <p class="mt-4 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)]">
            Claude, GPT, and Copilot is great for a single prompt. The Workbench is built for the multi-week pricing workflow an actuary actually runs, with the syllabus, the standards, and the audit trail in place from the first message to the deployed rater.
          </p>
        </div>
        <div class="md:col-span-7 grid md:grid-cols-2 gap-3 self-center">
          <div class="lesson-tile reveal" data-reveal-delay="0">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Syllabus</p>
            <p class="lesson-tile-title">Trained on CAS syllabus materials</p>
            <p class="lesson-tile-body">
              The model knows the terminology and the conventions before it touches your book. Trained on the CAS syllabus and the Actuarial Standards of Practice.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="120">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Citations</p>
            <p class="lesson-tile-title">Citations or it didn't happen</p>
            <p class="lesson-tile-body">
              Every base rate, factor, credit, and trend traces back to the page and cell it came from. If the agent cannot cite it, it does not ship.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="240">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Audit</p>
            <p class="lesson-tile-title">Audited before the user sees it</p>
            <p class="lesson-tile-body">
              Audit agents regrade every analysis before it reaches the actuary. Author, reviewer, and approver are separate. Every promotion is recorded.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="360">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Context</p>
            <p class="lesson-tile-title">Built for the long-running engagement</p>
            <p class="lesson-tile-body">
              The Workbench holds context across the full pricing cycle, from data ingest to deployed rater. Built for the multi-week workflow, not a single prompt.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Workflows 01–04 */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-12">
    {workflows.map((w, i) => (
      <article
        id={w.num === "02" ? "rating" : w.num === "03" ? "insight" : w.num === "04" ? "audit" : undefined}
        class="grid md:grid-cols-12 gap-8 md:gap-12 py-10 border-t border-[var(--rule)] first:border-t-0 scroll-mt-24 reveal"
      >
        <div class="md:col-span-5">
          {w.agent ? (
            <p class="eyebrow mb-2" style="color: var(--color-oxblood, #B400FE);">{w.agent}</p>
          ) : (
            <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.num}</p>
          )}
          <h2 class="mt-1 font-semibold text-[2rem] md:text-[2.25rem] leading-[1.1] tracking-[-0.015em]">{w.title}</h2>
          <p class="mt-3 text-[1.125rem] leading-[1.55] text-[var(--fg-muted)]">{w.body}</p>
        </div>
        <ul class="md:col-span-7 flex flex-col gap-3 self-center">
          {w.outcomes.map((line) => (
            <li class="flex gap-3 items-start">
              <span class="mt-[0.6rem] inline-block h-px w-5 bg-[var(--color-oxblood,#B400FE)]/70 flex-shrink-0" aria-hidden="true"></span>
              <p class="text-[1.125rem] leading-[1.5] text-[var(--fg)]">{line}</p>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  {/* Frequently asked questions */}
  <section id="faq" class="border-t border-[var(--rule)] bg-[var(--bg)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
      <div class="grid md:grid-cols-12 gap-10 mb-8">
        <div class="md:col-span-5 reveal">
          <p class="eyebrow mb-3">FAQ</p>
          <h2 class="font-semibold text-[2.5rem] md:text-[2.875rem] leading-[1.05] tracking-[-0.018em]">
            Frequently asked questions
          </h2>
        </div>
        <div class="md:col-span-7 reveal" data-reveal-delay="120">
          <p class="eyebrow mb-3 invisible select-none" aria-hidden="true">FAQ</p>
          <p class="text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)]">
            Common questions from chief actuaries, pricing teams, and the IT and risk officers who review us alongside them.
          </p>
        </div>
      </div>

      <div class="border-t border-[var(--rule)]">
        {faqs.map((f, i) => (
          <details class="group border-b border-[var(--rule)] reveal" data-reveal-delay={String(i * 80)}>
            <summary class="flex items-start gap-4 py-5 cursor-pointer list-none">
              <span class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase mt-1 w-8 flex-shrink-0">{String(i + 1).padStart(2, "0")}</span>
              <span class="flex-1 font-semibold text-[1.1875rem] leading-[1.4] tracking-[-0.005em] text-[var(--fg)]">{f.q}</span>
              <span
                aria-hidden="true"
                class="ml-3 mt-1 inline-flex h-6 w-6 items-center justify-center rounded-full border border-[var(--rule)] text-[var(--fg-muted)] transition-transform group-open:rotate-45 flex-shrink-0"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3">
                  <path d="M12 5v14" />
                  <path d="M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="pl-12 pr-10 pb-6 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
              {f.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
