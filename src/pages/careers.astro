---
const ycJobs = "https://www.ycombinator.com/companies/tesora/jobs";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Careers · Tesora</title>
    <meta name="description" content="Open roles at Tesora. Frontier AI for Actuaries." />
    <link rel="canonical" href={ycJobs} />
    <meta http-equiv="refresh" content={`0; url=${ycJobs}`} />
    <script set:html={`window.location.replace(${JSON.stringify(ycJobs)});`}></script>
  </head>
  <body>
    <p>Redirecting to <a href={ycJobs}>{ycJobs}</a>...</p>
  </body>
</html>
