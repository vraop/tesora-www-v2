---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import { fetchSubstackPosts } from "../lib/substack";
import { u } from "../lib/url";

const posts = await fetchSubstackPosts(12);

const fallback = [
  {
    slug: "can-ai-ever-be-useful-for-actuaries",
    title: "Can AI ever be useful for actuaries?",
    link: "https://tesoraai.substack.com/p/can-ai-ever-be-useful-for-actuaries",
    pubDate: "",
    iso: "",
    prettyDate: "",
    description: "On why generic chat tools fall short for regulated pricing work, and what an actuarial-native agent stack does instead.",
    excerpt: "On why generic chat tools fall short for regulated pricing work, and what an actuarial-native agent stack does instead.",
    contentHtml: "",
    author: "",
  },
  {
    slug: "actuaries-logical-aversion-to-ai",
    title: "Actuaries' Logical Aversion to AI",
    link: "https://tesoraai.substack.com/p/actuaries-logical-aversion-to-ai",
    pubDate: "",
    iso: "",
    prettyDate: "",
    description: "Fear of agentic AI is well-founded, but can be mitigated.",
    excerpt: "Fear of agentic AI is well-founded, but can be mitigated.",
    contentHtml: "",
    author: "",
  },
];
const notes = posts.length > 0 ? posts : fallback;

const milestones = [
  {
    date: "2025 · SEP",
    title: "Tesora completes Y Combinator S25",
    body: "Tesora completed the Y Combinator Summer 2025 cohort focused on AI-native applications for regulated industries.",
    logo: { slug: "y-combinator", alt: "Y Combinator S25" },
  },
];

const priorResearch = [
  {
    title: "Relational deep learning for enterprise data.",
    venue: "Stanford / Kumo Labs · 2024",
    body: "Graph neural networks operating directly on relational tables. The prior research that underpins the substrate Tesora uses to hold filings, raters, exposures, and quotes as one typed graph.",
    href: "https://relbench.stanford.edu",
    logos: [
      { slug: "stanford", alt: "Stanford" },
      { slug: "kumo", alt: "Kumo Labs" },
    ],
  },
];
---

<Layout
  title="Media · Tesora"
  description="Notes, announcements, and prior research from Tesora. Backed by Foundation Capital and Y Combinator."
  canonical="/media"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/research-loop.mp4")}
    headline="Notes, announcements, and prior research"
    deck="Short pieces on specialty P&C pricing, AI for actuaries, and the rating function, mixed in with company news."
    primaryCta={{ label: "Read on Substack", href: "https://tesoraai.substack.com/" }}
    secondaryCta={{ label: "Email us", href: "mailto:founders@tesora.ai" }}
  />

  {/* Investors */}
  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]" id="investors">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
      <div class="grid md:grid-cols-12 gap-10 mb-12">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">Investors</p>
          <h2 class="font-semibold text-[2.5rem] leading-[1.1] tracking-[-0.015em]">
            Backed by leading AI investors
          </h2>
        </div>
        <div class="md:col-span-7">
          <p class="text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)]">
            Backed by Y Combinator and Foundation Capital, joined by 40+ angel investors including investors and operators at OpenAI, Bain Capital, and Greenoaks.
          </p>
          <p class="mt-4 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)]">
            Our thesis is actuarial work needs an opinionated, vertical AI trained on the standards and math reflected in becoming an actuary, not a generalist model that does everything.
          </p>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-10 md:gap-16 items-center max-w-[640px] mx-auto">
        <div class="flex items-center justify-center gap-3 py-2">
          <img
            src={u(`/logos/y-combinator.svg`)}
            alt="Y Combinator S25"
            style="height: 36px; filter: var(--logo-filter);"
            class="w-auto opacity-80 hover:opacity-100 transition-opacity"
            loading="lazy"
          />
          <span class="text-[1.0625rem] font-semibold tracking-tight text-[var(--fg)] opacity-85">Y Combinator <span class="text-[var(--fg-muted)] font-normal">S25</span></span>
        </div>
        <div class="flex items-center justify-center py-2">
          <img
            src={u(`/logos/foundation-capital.svg`)}
            alt="Foundation Capital"
            style="height: 32px; filter: var(--logo-filter);"
            class="w-auto opacity-80 hover:opacity-100 transition-opacity"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  {/* Notes & announcements — auto-fed by Substack RSS */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-24" id="blog">
    <div class="flex items-end justify-between gap-6 mb-10">
      <div>
        <p class="eyebrow mb-3">Notes and announcements</p>
        <h2 class="font-semibold text-[2.5rem] leading-[1.1] tracking-[-0.015em]">
          From the Tesora Substack.
        </h2>
        <p class="mt-4 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)] max-w-[640px]">
          Short pieces from the people building Tesora. Newest first. Updates land here automatically when we publish.
        </p>
      </div>
      <a
        href="https://tesoraai.substack.com"
        target="_blank"
        rel="noopener"
        class="link text-sm whitespace-nowrap hidden md:inline"
      >
        All posts →
      </a>
    </div>

    <div class="notes-rail" role="list">
      {notes.map((p) => {
        const onSite = p.contentHtml && p.contentHtml.length > 0;
        const href = onSite ? u(`/notes/${p.slug}`) : p.link;
        return (
          <a
            role="listitem"
            href={href}
            target={onSite ? undefined : "_blank"}
            rel={onSite ? undefined : "noopener"}
            class="notes-card"
          >
            {p.pubDate && <p class="notes-card__date tabular">{p.pubDate}</p>}
            <h3 class="notes-card__title">{p.title}</h3>
            <p class="notes-card__excerpt">{p.excerpt}</p>
            <span class="notes-card__cta">{onSite ? "Read →" : "Read on Substack →"}</span>
          </a>
        );
      })}
    </div>

    <p class="mt-6 text-sm text-[var(--fg-muted)] md:hidden">
      <a href="https://tesoraai.substack.com" target="_blank" rel="noopener" class="link">All posts on Substack →</a>
    </p>

    {milestones.length > 0 && (
      <div class="mt-20">
        <p class="eyebrow mb-6">Milestones</p>
        {milestones.map((m) => (
          <article class="grid md:grid-cols-12 gap-6 md:gap-10 py-8 border-t border-[var(--rule)] first:border-t-0">
            <div class="md:col-span-3">
              <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{m.date}</p>
              {m.logo && (
                <img
                  src={u(`/logos/${m.logo.slug}.svg`)}
                  alt={m.logo.alt}
                  class="mt-3 h-4 w-auto opacity-60"
                  style="filter: var(--logo-filter);"
                  loading="lazy"
                />
              )}
            </div>
            <div class="md:col-span-9">
              <h3 class="font-semibold text-[1.4375rem] leading-[1.25] tracking-[-0.005em]">{m.title}</h3>
              <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{m.body}</p>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

  {/* Prior research */}
  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]" id="prior-research">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
      <div class="grid md:grid-cols-12 gap-10 mb-10">
        <div class="md:col-span-4">
          <p class="eyebrow mb-3">Prior research</p>
          <h2 class="font-semibold text-[2.25rem] leading-[1.1] tracking-[-0.015em]">
            The research under the substrate.
          </h2>
        </div>
        <p class="md:col-span-8 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)] mt-2">
          The technical foundation underneath Tesora's substrate: published work on graph neural networks for relational and tabular data, kept distinct because it predates the company and lives in academic venues.
        </p>
      </div>
      <div>
        {priorResearch.map((w) => (
          <article class="border-t border-[var(--rule)] py-8 first:border-t-0">
            <div class="flex items-center gap-4 flex-wrap">
              <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.venue}</p>
              {w.logos && w.logos.length > 0 && (
                <div class="flex items-center gap-3">
                  {w.logos.map((l) => (
                    <img
                      src={u(`/logos/${l.slug}.svg`)}
                      alt={l.alt}
                      class="h-4 w-auto opacity-60"
                      style="filter: var(--logo-filter);"
                      loading="lazy"
                    />
                  ))}
                </div>
              )}
            </div>
            <h3 class="mt-2 font-semibold text-[1.4375rem] leading-[1.25] tracking-[-0.005em]">{w.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{w.body}</p>
            {w.href && (
              <p class="mt-3">
                <a href={w.href} class="link text-sm" target="_blank" rel="noopener">Read →</a>
              </p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .notes-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(320px, 360px);
    gap: 18px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 4px 4px 18px;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklab, var(--color-oxblood) 40%, transparent) transparent;
  }
  .notes-rail::-webkit-scrollbar {
    height: 8px;
  }
  .notes-rail::-webkit-scrollbar-thumb {
    background: color-mix(in oklab, var(--color-oxblood) 32%, transparent);
    border-radius: 999px;
  }
  .notes-card {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px 24px;
    background: #ffffff;
    color: var(--fg);
    border: 1px solid var(--rule);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
  }
  :global([data-theme="dark"]) .notes-card {
    background: rgba(250, 247, 240, 0.04);
  }
  .notes-card:hover {
    border-color: color-mix(in oklab, var(--color-oxblood) 40%, var(--rule));
    box-shadow: 0 14px 30px -22px color-mix(in oklab, var(--color-oxblood) 50%, transparent);
    transform: translateY(-2px);
  }
  .notes-card__date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-oxblood);
    margin: 0;
  }
  .notes-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
    margin: 0;
  }
  .notes-card__excerpt {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--fg-muted);
    margin: 0;
    flex: 1;
  }
  .notes-card__cta {
    font-size: 0.8125rem;
    color: var(--color-oxblood);
    font-weight: 500;
    margin-top: 4px;
  }
</style>
