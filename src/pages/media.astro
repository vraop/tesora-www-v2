---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import { u } from "../lib/url";

const blog = [
  {
    date: "2026 · MAY",
    kind: "post",
    title: "Actuaries' Logical Aversion to AI",
    authors: "Philo Bishay, Vivek Rao",
    body: "Fear of agentic AI is well-founded, but can be mitigated.",
    href: "https://tesoraai.substack.com/p/actuaries-logical-aversion-to-ai",
  },
  {
    date: "2026 · MAY",
    kind: "post",
    title: "Can AI ever be useful for actuaries? My first 'Wow Factor'",
    authors: "Philo Bishay",
    body: "An actuary's frustration with software that never seemed to work.",
    href: "https://tesoraai.substack.com/",
  },
  {
    date: "2025 · SEP",
    kind: "news",
    title: "Tesora completes Y Combinator S25",
    body: "Tesora completed the Y Combinator Summer 2025 cohort focused on AI-native applications for regulated industries.",
    logo: { slug: "y-combinator", alt: "Y Combinator S25" },
  },
];

const priorResearch = [
  {
    title: "Relational deep learning for enterprise data.",
    venue: "Stanford / Kumo Labs · 2024",
    body: "Graph neural networks operating directly on relational tables. The prior research that underpins the substrate Tesora uses to hold filings, raters, exposures, and quotes as one typed graph.",
    href: "https://relbench.stanford.edu",
    logos: [
      { slug: "stanford", alt: "Stanford" },
      { slug: "kumo", alt: "Kumo Labs" },
    ],
  },
];
---

<Layout
  title="Media · Tesora"
  description="Notes from Tesora. A team of SF technologists taking a contrarian shot at actuarial AI: opinionated agents with context preserved across hundreds of thousands of documents."
  canonical="/media"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/research-loop.mp4")}
    headline="A contrarian shot at actuarial AI"
    deck="A team of SF technologists giving actuaries the full power of frontier models. Opinionated agents trained on the standards. Context preserved across hundreds of thousands of documents."
    primaryCta={{ label: "Read on Substack", href: "https://tesoraai.substack.com/" }}
    secondaryCta={{ label: "Email us", href: "mailto:founders@tesora.ai" }}
  />

  {/* Thesis */}
  <section class="bg-[var(--bg)] border-b border-[var(--rule)]" id="thesis">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20 md:py-24 grid md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-5">
        <p class="eyebrow mb-3">Thesis</p>
        <h2 class="font-semibold text-[2.5rem] leading-[1.1] tracking-[-0.015em]">
          Opinionated agents, context preserved
        </h2>
      </div>
      <div class="md:col-span-7 grid gap-5">
        <p class="text-[1.1875rem] leading-[1.6] text-[var(--fg)]">
          Tesora is a team of SF technologists taking a shot at the work the industry has tried to solve with generalist AI. The goal is simple: empower the actuary with the full power of frontier models, not the partial slice a chat window can hold.
        </p>
        <p class="text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)]">
          The bet is contrarian. Opinionated agents trained on the CAS syllabus and the Actuarial Standards of Practice, with context preserved across hundreds of thousands of filings, memos, loss runs, and prior reviews. In any regulated industry the history is enormous and the answer has to be defendable years later. That is the part generic AI keeps getting wrong, and it is the part we are built to solve.
        </p>
      </div>
    </div>
  </section>

  {/* Investors */}
  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]" id="investors">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
      <div class="grid md:grid-cols-12 gap-10 mb-12">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">Investors</p>
          <h2 class="font-semibold text-[2.5rem] leading-[1.1] tracking-[-0.015em]">
            Backed by leading AI investors
          </h2>
        </div>
        <div class="md:col-span-7">
          <p class="text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)]">
            Backed by Y Combinator and Foundation Capital, joined by 40+ angel investors including leaders at OpenAI, Bain Capital, and Greenoaks. The investors who came in early share the contrarian read: actuarial work needs opinionated, vertical AI with context preserved at scale, not a generalist model that does everything.
          </p>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-10 md:gap-16 items-center max-w-[640px] mx-auto">
        <div class="flex items-center justify-center gap-3 py-2">
          <img
            src={u(`/logos/y-combinator.svg`)}
            alt="Y Combinator S25"
            style="height: 36px; filter: var(--logo-filter);"
            class="w-auto opacity-80 hover:opacity-100 transition-opacity"
            loading="lazy"
          />
          <span class="text-[1.0625rem] font-semibold tracking-tight text-[var(--fg)] opacity-85">Y Combinator <span class="text-[var(--fg-muted)] font-normal">S25</span></span>
        </div>
        <div class="flex items-center justify-center py-2">
          <img
            src={u(`/logos/foundation-capital.svg`)}
            alt="Foundation Capital"
            style="height: 32px; filter: var(--logo-filter);"
            class="w-auto opacity-80 hover:opacity-100 transition-opacity"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  {/* Blog — news + writing in one feed */}
  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-24" id="blog">
    <div class="grid md:grid-cols-12 gap-10 mb-12">
      <div class="md:col-span-4">
        <p class="eyebrow mb-3">Blog</p>
        <h2 class="font-semibold text-[2.5rem] leading-[1.1] tracking-[-0.015em]">
          Notes and announcements.
        </h2>
      </div>
      <p class="md:col-span-8 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)] mt-2">
        Short pieces from the people building Tesora, mixed in with company news. Newest first.
      </p>
    </div>

    <div>
      {blog.map((p) => (
        <article class="grid md:grid-cols-12 gap-6 md:gap-10 py-8 border-t border-[var(--rule)] first:border-t-0">
          <div class="md:col-span-3">
            <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{p.date}</p>
            <p class="mt-2 text-[0.8125rem] text-[var(--fg-muted)]">
              {p.kind === "news" ? "Tesora" : p.authors}
            </p>
            {p.logo && (
              <img
                src={u(`/logos/${p.logo.slug}.svg`)}
                alt={p.logo.alt}
                class="mt-3 h-4 w-auto opacity-60"
                style="filter: var(--logo-filter);"
                loading="lazy"
              />
            )}
          </div>
          <div class="md:col-span-9">
            <h3 class="font-semibold text-[1.4375rem] leading-[1.25] tracking-[-0.005em]">{p.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{p.body}</p>
            {p.href && (
              <p class="mt-3">
                <a href={p.href} class="link text-sm" target="_blank" rel="noopener">Read on Substack →</a>
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  {/* Prior research */}
  <section class="bg-[var(--bg-panel)] border-y border-[var(--rule)]" id="prior-research">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
      <div class="grid md:grid-cols-12 gap-10 mb-10">
        <div class="md:col-span-4">
          <p class="eyebrow mb-3">Prior research</p>
          <h2 class="font-semibold text-[2.25rem] leading-[1.1] tracking-[-0.015em]">
            The research under the substrate.
          </h2>
        </div>
        <p class="md:col-span-8 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)] mt-2">
          The technical foundation underneath Tesora's substrate: published work on graph neural networks for relational and tabular data, kept distinct because it predates the company and lives in academic venues.
        </p>
      </div>
      <div>
        {priorResearch.map((w) => (
          <article class="border-t border-[var(--rule)] py-8 first:border-t-0">
            <div class="flex items-center gap-4 flex-wrap">
              <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.venue}</p>
              {w.logos && w.logos.length > 0 && (
                <div class="flex items-center gap-3">
                  {w.logos.map((l) => (
                    <img
                      src={u(`/logos/${l.slug}.svg`)}
                      alt={l.alt}
                      class="h-4 w-auto opacity-60"
                      style="filter: var(--logo-filter);"
                      loading="lazy"
                    />
                  ))}
                </div>
              )}
            </div>
            <h3 class="mt-2 font-semibold text-[1.4375rem] leading-[1.25] tracking-[-0.005em]">{w.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-[1.6] text-[var(--fg-muted)]">{w.body}</p>
            {w.href && (
              <p class="mt-3">
                <a href={w.href} class="link text-sm" target="_blank" rel="noopener">Read →</a>
              </p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
