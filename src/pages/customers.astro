---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CinematicHero from "../components/CinematicHero.astro";
import { u } from "../lib/url";
---

<Layout
  title="Customers · Tesora"
  description="Tesora serves specialty P&C carriers pricing the lines that don't fit a textbook, and admitted carriers monitoring filings and benchmarking competitors."
  canonical="/customers"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/customers-loop.mp4")}
    headline="Built for chief actuaries"
    deck="One platform, two motions. Pick the one that fits."
    primaryCta={{ label: "Talk to Tesora", href: "mailto:founders@tesora.ai" }}
    secondaryCta={{ label: "Security & compliance", href: u("/security") }}
  />

  <section class="mx-auto max-w-[1180px] px-6 md:px-10 py-24">
    <div class="grid md:grid-cols-2 gap-6">
      <a href={u("/non-admitted")} class="group block border border-[var(--rule)] rounded-[5px] p-10 hover:border-[var(--fg)]/40 transition-colors">
        <p class="eyebrow mb-3">Specialty · E&amp;S</p>
        <h2 class="font-semibold text-[2.25rem] leading-[1.1] tracking-[-0.015em] group-hover:text-[var(--color-oxblood)] transition-colors">
          Non-Admitted
        </h2>
        <p class="mt-4 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
          Bind-ready pricing under E&amp;S speed. Submission triage, manuscript flex, deviation accounting. Quote in under 6 weeks, not six months.
        </p>
        <p class="mt-6 text-sm font-medium text-[var(--fg)] group-hover:text-[var(--color-oxblood)] transition-colors">See the E&amp;S motion →</p>
      </a>

      <a href={u("/admitted")} class="group block border border-[var(--rule)] rounded-[5px] p-10 hover:border-[var(--fg)]/40 transition-colors">
        <p class="eyebrow mb-3">Admitted · Market intelligence</p>
        <h2 class="font-semibold text-[2.25rem] leading-[1.1] tracking-[-0.015em] group-hover:text-[var(--color-oxblood)] transition-colors">
          Admitted
        </h2>
        <p class="mt-4 text-[1.0625rem] leading-[1.6] text-[var(--fg-muted)]">
          Filing-driven raters with SOX-grade audit. SERFF ingest, rate-committee briefs, DOI prep packets, regression tests against the filed manual.
        </p>
        <p class="mt-6 text-sm font-medium text-[var(--fg)] group-hover:text-[var(--color-oxblood)] transition-colors">See the admitted motion →</p>
      </a>
    </div>
  </section>

  <Footer />
</Layout>
