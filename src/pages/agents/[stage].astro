---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LifecycleReport from "../../components/LifecycleReport.astro";
import SubNav from "../../components/SubNav.astro";
import { lifecycleStages } from "../../data/lifecycle-stages";
import { u } from "../../lib/url";

export function getStaticPaths() {
  return lifecycleStages.map((s) => ({
    params: { stage: s.id },
    props: { stage: s },
  }));
}

const { stage } = Astro.props;

const agentSlug = stage.agent === "Insight" ? "insight" : "rating";
const siblingStages = lifecycleStages.filter((s) => s.agent === stage.agent);
const otherAgentSlug = stage.agent === "Insight" ? "rating" : "insight";
const otherAgentLabel = stage.agent === "Insight" ? "Rating Agent" : "Insight Agent";

const subnavLinks = [
  { label: "Overview", href: u(`/agents/${agentSlug}`) },
  ...siblingStages.map((s) => ({
    label: s.label,
    href: u(`/agents/${s.id}`),
    active: s.id === stage.id,
  })),
  { label: otherAgentLabel, href: u(`/agents/${otherAgentSlug}`) },
];
---

<Layout
  title={stage.seo.title}
  description={stage.seo.description}
  canonical={`/agents/${stage.id}`}
  schemaType="WebPage"
>
  <Header variant="light" />

  <div class="pt-16 md:pt-20">
    <SubNav
      sectionLabel={`${stage.agent} Agent`}
      sectionHref={u(`/agents/${agentSlug}`)}
      links={subnavLinks}
    />
  </div>

  <section class="border-b border-[var(--rule)] bg-[var(--bg)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 pt-10 md:pt-12 pb-12">
      <p class="eyebrow mb-4">{stage.label}</p>
      <h1 class="font-semibold text-[2.25rem] md:text-[2.875rem] leading-[1.05] tracking-[-0.018em] max-w-[820px]">
        {stage.seo.h1}
      </h1>
      <p class="mt-5 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)] max-w-[680px]">
        {stage.body}
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="https://cal.com/team/tesora/quick-chat" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium tracking-tight bg-[var(--color-oxblood)] text-white hover:opacity-90 transition-opacity rounded-full">
          Request a walkthrough
        </a>
        <a href={u("/agents")} class="inline-flex items-center text-sm font-medium tracking-tight text-[var(--fg)] hover:text-[var(--color-oxblood)] transition-colors px-5 py-2.5">
          ← All agents
        </a>
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--rule)] bg-[var(--bg-panel)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16 md:py-20">
      <div class="grid md:grid-cols-12 gap-8 md:gap-10 items-start">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">Example output</p>
          <h2 class="font-semibold text-[1.5rem] md:text-[1.75rem] leading-[1.2] tracking-[-0.008em]">
            {stage.title}
          </h2>
          <p class="lifecycle-followup__eyebrow mt-8">Ask a follow-up</p>
          <ul class="lifecycle-followup__list">
            {stage.followups.map((f) => (
              <li class="lifecycle-followup">
                <p class="lifecycle-followup__title">{f.title}</p>
                <p class="lifecycle-followup__body">{f.body}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="md:col-span-7">
          <figure class="lifecycle-mockup">
            <LifecycleReport report={stage.report} />
          </figure>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .lifecycle-followup__eyebrow {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in oklab, #B400FE 70%, var(--fg-muted));
    margin-bottom: 12px;
  }
  .lifecycle-followup__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .lifecycle-followup {
    --lc-accent: #B400FE;
    border: 1px solid color-mix(in oklab, var(--lc-accent) 14%, rgba(14, 14, 12, 0.08));
    background: var(--bg);
    border-radius: 5px;
    padding: 12px 14px;
    color: var(--fg);
  }
  [data-theme="dark"] .lifecycle-followup {
    background: rgba(250, 247, 240, 0.03);
    border-color: color-mix(in oklab, var(--lc-accent) 24%, rgba(250, 247, 240, 0.12));
  }
  .lifecycle-followup__title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: var(--fg);
  }
  .lifecycle-followup__body {
    margin-top: 4px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .lifecycle-mockup {
    --lc-accent: #B400FE;
    margin: 0;
    border-radius: 5px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid color-mix(in oklab, var(--lc-accent) 18%, rgba(14, 14, 12, 0.08));
    box-shadow:
      0 1px 0 rgba(14, 14, 12, 0.04),
      0 24px 60px -34px color-mix(in oklab, var(--lc-accent) 40%, rgba(14, 14, 12, 0.18));
  }
</style>
