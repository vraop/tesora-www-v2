---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CinematicHero from "../../components/CinematicHero.astro";
import HarnessDiagram from "../../components/HarnessDiagram.astro";
import SubNav from "../../components/SubNav.astro";
import { lifecycleStages } from "../../data/lifecycle-stages";
import { u } from "../../lib/url";

const ratingStage = lifecycleStages.find((s) => s.id === "rating-deployment")!;

const subnavLinks = [
  { label: "Overview", href: u("/agents/rating"), active: true },
  { label: ratingStage.label, href: u(`/agents/${ratingStage.id}`) },
  { label: "Insight Agent", href: u("/agents/insight") },
];

type Workflow = { num: string; title: string; body: string; outcomes: string[] };
const workflows: Workflow[] = [
  {
    num: "01",
    title: "Read any rater you have",
    body: "Excel raters, SERFF filings, rate manuals, internal pricing tools. The Rating Agent reads them and rebuilds the model, factor by factor, with every value tied back to the source.",
    outcomes: [
      "Excel formulas parsed, factor tables identified",
      "Versioned model created, existing logic preserved",
      "Every factor cites its source",
    ],
  },
  {
    num: "02",
    title: "Version every change",
    body: "Actuaries should not wait on IT to deploy a rater. Edit it in the Workbench. Every factor change is versioned with who, when, and why. Ship to a callable pricing API when the reviewer and approver sign off.",
    outcomes: [
      "Base rates, factors, ILFs, schedule mods",
      "Author, reviewer, approver are separate people",
      "Deploy to a GUI, an API, or back to Excel",
    ],
  },
  {
    num: "03",
    title: "Audit and ship",
    body: "An audit agent regrades every rater against a battery of actuarial tests before it reaches production. Author, reviewer, and approver are separate people. The audit log records every promotion.",
    outcomes: [
      "Author, reviewer, approver are separate people",
      "Every promotion recorded with who, when, and what",
      "Every deployed rater is reviewable end to end",
    ],
  },
];
---

<Layout
  title="Rating Agent · Tesora"
  description="The Rating Agent reads raters from Excel and SERFF, versions every change, and ships to a callable pricing API. Author, reviewer, and approver are separate people. For chief actuaries at specialty P&C carriers and MGAs."
  canonical="/agents/rating"
  schemaType="WebPage"
>
  <Header variant="transparent" />

  <CinematicHero
    videoSrc={u("/video/workbench-loop.mp4")}
    headline="A rater your underwriters can quote off of"
    deck="The Rating Agent reads raters from Excel and SERFF, versions every change, and deploys to a callable pricing API. Author, reviewer, and approver are separate people from the first edit."
    primaryCta={{ label: "Request a walkthrough", href: "https://cal.com/team/tesora/quick-chat" }}
    secondaryCta={{ label: "How it works", href: "#workflow" }}
  />

  <SubNav sectionLabel="Rating Agent" sectionHref={u("/agents/rating")} links={subnavLinks} />

  {/* Stage this agent covers */}
  <section class="border-b border-[var(--rule)] bg-[var(--bg)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
      <div class="grid md:grid-cols-12 gap-10 mb-10">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">Stage it covers</p>
          <h2 class="font-semibold text-[2.25rem] md:text-[2.5rem] leading-[1.1] tracking-[-0.015em]">
            One stage, the deployed rater
          </h2>
        </div>
        <p class="md:col-span-7 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)] mt-2">
          Everything else in pricing is preparation. The deployed rater is what underwriters quote off of, what regulators review, and what your auditors test. The Rating Agent is dedicated to that one job.
        </p>
      </div>
      <div class="grid md:grid-cols-1 gap-4 max-w-[760px]">
        <a
          href={u(`/agents/${ratingStage.id}`)}
          aria-label={`See the ${ratingStage.label} stage`}
          class="group relative block border border-[var(--rule)] rounded-[5px] p-6 pr-12 hover:border-[var(--color-oxblood)]/50 transition-colors bg-[var(--bg-panel)]"
        >
          <p class="eyebrow mb-2">{ratingStage.label}</p>
          <p class="font-semibold text-[1.25rem] leading-[1.3] tracking-[-0.005em] group-hover:text-[var(--color-oxblood)] transition-colors">
            {ratingStage.title}
          </p>
          <p class="mt-2 text-[1rem] leading-[1.5] text-[var(--fg-muted)]">
            {ratingStage.body}
          </p>
          <span
            aria-hidden="true"
            class="absolute right-5 bottom-5 text-[var(--color-oxblood)] text-lg leading-none transition-transform group-hover:translate-x-1"
          >→</span>
        </a>
      </div>
    </div>
  </section>

  {/* Workbench / Harness */}
  <section id="harness" class="border-b border-[var(--rule)] bg-[var(--bg)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-20">
      <div class="grid md:grid-cols-12 gap-10 md:gap-14 items-start mb-12">
        <div class="md:col-span-5">
          <p class="eyebrow mb-3">How it works</p>
          <h2 class="font-semibold text-[2.5rem] md:text-[2.875rem] leading-[1.05] tracking-[-0.018em]">
            The Workbench, with a harness underneath
          </h2>
        </div>
        <div class="md:col-span-7">
          <p class="text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)]">
            The actuary uses the Workbench: a chat window next to Excel, where the actuary edits the rater directly. The Rating Agent works inside the harness, a framework that enforces citations, audit logs, and separation of duties. The agent is trained on actuarial science, the Actuarial Standards of Practice, and the qualification standards. Every decision is the actuary's.
          </p>
        </div>
      </div>
      <HarnessDiagram />
    </div>
  </section>

  {/* Why a workbench */}
  <section id="different" class="border-b border-[var(--rule)] bg-[var(--bg)] scroll-mt-24">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16">
      <div class="grid md:grid-cols-12 gap-8">
        <div class="md:col-span-5 reveal">
          <p class="eyebrow mb-3">Built for actuaries</p>
          <h2 class="font-semibold text-[2.5rem] md:text-[2.875rem] leading-[1.05] tracking-[-0.018em]">
            Built for the deployed rater, not the demo
          </h2>
          <p class="mt-4 text-[1.1875rem] leading-[1.6] text-[var(--fg-muted)]">
            Claude, GPT, and Copilot are great for a single prompt. The Rating Agent is built for the production rater an underwriter actually quotes off of. Versioning, separation of duties, and a callable API from the first edit.
          </p>
        </div>
        <div class="md:col-span-7 grid md:grid-cols-2 gap-3 self-center">
          <div class="lesson-tile reveal" data-reveal-delay="0">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Sources</p>
            <p class="lesson-tile-title">SERFF and Excel, both supported</p>
            <p class="lesson-tile-body">
              Pull a competitor rater from a SERFF filing or rebuild your own from an Excel file. Same target. Same audit trail.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="120">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Separation</p>
            <p class="lesson-tile-title">Author, reviewer, approver separated</p>
            <p class="lesson-tile-body">
              Three people, three roles, three environments. No actuary pushes a rater to production alone. Every promotion records who signed off and when.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="240">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Callable</p>
            <p class="lesson-tile-title">GUI, API, or Excel, your call</p>
            <p class="lesson-tile-body">
              Deploy the rater behind a callable pricing API, into a GUI for underwriters, or back into a versioned Excel file. The same rater, the same logic.
            </p>
          </div>
          <div class="lesson-tile reveal" data-reveal-delay="360">
            <div class="lesson-tile-icon" aria-hidden="true"><span class="lesson-tile-dot"></span></div>
            <p class="lesson-tile-eyebrow">Versioned</p>
            <p class="lesson-tile-title">Every edit recorded, every state recoverable</p>
            <p class="lesson-tile-body">
              Every factor change is versioned with who, when, and why. Roll back any rater to any prior approved state.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Workflow */}
  <section id="workflow" class="mx-auto max-w-[1180px] px-6 md:px-10 py-12 scroll-mt-24">
    {workflows.map((w) => (
      <article class="grid md:grid-cols-12 gap-8 md:gap-12 py-10 border-t border-[var(--rule)] first:border-t-0 scroll-mt-24 reveal">
        <div class="md:col-span-5">
          <p class="font-mono text-xs tracking-[0.18em] text-[var(--fg-muted)] uppercase">{w.num}</p>
          <h2 class="mt-1 font-semibold text-[2rem] md:text-[2.25rem] leading-[1.1] tracking-[-0.015em]">{w.title}</h2>
          <p class="mt-3 text-[1.125rem] leading-[1.55] text-[var(--fg-muted)]">{w.body}</p>
        </div>
        <ul class="md:col-span-7 flex flex-col gap-3 self-center">
          {w.outcomes.map((line) => (
            <li class="flex gap-3 items-start">
              <span class="mt-[0.6rem] inline-block h-px w-5 bg-[var(--color-oxblood,#B400FE)]/70 flex-shrink-0" aria-hidden="true"></span>
              <p class="text-[1.125rem] leading-[1.5] text-[var(--fg)]">{line}</p>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  {/* CTA */}
  <section class="border-t border-[var(--rule)] bg-[var(--bg-panel)]">
    <div class="mx-auto max-w-[1180px] px-6 md:px-10 py-16 text-center">
      <h2 class="font-semibold text-[2rem] md:text-[2.5rem] leading-[1.1] tracking-[-0.015em] max-w-[680px] mx-auto">
        Bring us any rater
      </h2>
      <p class="mt-4 text-[1.125rem] leading-[1.6] text-[var(--fg-muted)] max-w-[560px] mx-auto">
        Excel, SERFF, internal pricing tool. We rebuild it in the Workbench, version it, and walk through deploying it to a callable pricing API with you.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 justify-center">
        <a href="https://cal.com/team/tesora/quick-chat" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium tracking-tight bg-[var(--color-oxblood)] text-white hover:opacity-90 transition-opacity rounded-full">
          Request a walkthrough
        </a>
        <a href={u("/agents/insight")} class="inline-flex items-center text-sm font-medium tracking-tight text-[var(--fg)] hover:text-[var(--color-oxblood)] transition-colors px-5 py-2.5">
          See the Insight Agent →
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
