---
type Layer = {
  num: string;
  title: string;
  body: string;
  bullets?: string[];
};

export interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  layers: Layer[];
}

const { eyebrow, title, intro, layers } = Astro.props;
---

<section class="ls" aria-label={title ?? "Tesora layered stack"} data-ls>
  <div class="ls-grid">
    <aside class="ls-aside">
      {eyebrow && <p class="ls-eyebrow">{eyebrow}</p>}
      {title && <h2 class="ls-title" style="text-wrap: balance;">{title}</h2>}
      {intro && <p class="ls-intro" style="text-wrap: pretty;">{intro}</p>}
    </aside>

    <ol class="ls-track" role="list">
      {layers.map((l, i) => (
        <li class="ls-card" data-ls-card={i} style={`--i:${i}; --total:${layers.length}`}>
          <header class="ls-card__head">
            <span class="ls-card__num" aria-hidden="true">{l.num}</span>
            <div class="ls-card__main">
              <h3 class="ls-card__title">{l.title}</h3>
              <p class="ls-card__body">{l.body}</p>
            </div>
          </header>
          {l.bullets && l.bullets.length > 0 && (
            <ul class="ls-card__bullets">
              {l.bullets.map((b) => (
                <li>
                  <span class="ls-card__dot" aria-hidden="true"></span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .ls {
    --ls-accent: var(--color-oxblood, #B400FE);
    --ls-rule: var(--rule, rgba(14, 14, 12, 0.10));
    --ls-card-bg: #FFFFFF;
    --ls-fg: var(--fg, #0E0E0C);
    --ls-muted: var(--fg-muted, #6B6760);
    --ls-sticky-top: 96px;
    --ls-stagger: 14px;
    --ls-buffer: 56vh;
  }

  .ls-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    align-items: start;
  }

  .ls-aside {
    position: sticky;
    top: var(--ls-sticky-top);
    align-self: start;
    padding-top: 6px;
  }
  .ls-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ls-accent);
    margin: 0 0 12px;
  }
  .ls-title {
    margin: 0;
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.018em;
    color: var(--ls-fg);
  }
  .ls-intro {
    margin: 18px 0 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ls-muted);
    max-width: 460px;
  }

  /* Track is the single containing block; cards stack inside it. */
  .ls-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: block;
  }

  /* Each card is sticky at a progressively lower top, so later cards
     overlay earlier cards with a 14px sliver of the previous one showing. */
  .ls-card {
    list-style: none;
    position: sticky;
    top: calc(var(--ls-sticky-top) + var(--i) * var(--ls-stagger));
    margin-bottom: var(--ls-buffer);
    z-index: calc(var(--i) + 1);

    background: var(--ls-card-bg);
    border: 1px solid var(--ls-rule);
    border-radius: 6px;
    box-shadow:
      0 1px 0 rgba(14, 14, 12, 0.04),
      0 18px 36px -28px rgba(14, 14, 12, 0.22);
    overflow: hidden;
    transition: border-color 280ms ease, box-shadow 280ms ease, transform 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ls-card:last-child {
    margin-bottom: 0;
  }
  .ls-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--ls-accent);
    opacity: 0;
    transition: opacity 220ms ease;
  }
  .ls-card.is-active {
    border-color: color-mix(in oklab, var(--ls-accent) 38%, var(--ls-rule));
    box-shadow:
      0 1px 0 rgba(14, 14, 12, 0.04),
      0 22px 42px -24px color-mix(in oklab, var(--ls-accent) 55%, transparent);
  }
  .ls-card.is-active::before {
    opacity: 1;
  }

  .ls-card__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 16px;
    padding: 22px 26px 18px;
  }
  .ls-card__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 28px;
    padding: 0 10px;
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: color-mix(in oklab, var(--ls-accent) 12%, transparent);
    color: var(--ls-accent);
    border: 1px solid color-mix(in oklab, var(--ls-accent) 24%, transparent);
  }
  .ls-card__main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .ls-card__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.008em;
    color: var(--ls-fg);
  }
  .ls-card__body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ls-muted);
  }

  .ls-card__bullets {
    list-style: none;
    margin: 0;
    padding: 4px 26px 22px 80px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px 22px;
  }
  .ls-card__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ls-fg);
  }
  .ls-card__dot {
    margin-top: 7px;
    flex: 0 0 auto;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--ls-accent);
  }

  @media (max-width: 900px) {
    .ls {
      --ls-buffer: 0;
      --ls-sticky-top: 80px;
    }
    .ls-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .ls-aside {
      position: static;
    }
    .ls-track {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .ls-card {
      position: static;
      margin-bottom: 0;
    }
    .ls-card__bullets {
      padding-left: 22px;
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ls-card {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const sections = document.querySelectorAll<HTMLElement>("[data-ls]");
    if (!sections.length) return;

    for (const section of sections) {
      const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-ls-card]"));
      if (!cards.length) continue;

      const setActive = (idx: number) => {
        cards.forEach((c, i) => {
          c.classList.toggle("is-active", i === idx);
        });
      };

      const onScroll = () => {
        let activeIndex = 0;
        cards.forEach((card, i) => {
          const rect = card.getBoundingClientRect();
          const stickyTop = parseFloat(getComputedStyle(card).top) || 96;
          if (rect.top <= stickyTop + 2) activeIndex = i;
        });
        setActive(activeIndex);
      };

      setActive(0);
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      onScroll();
    }
  })();
</script>
