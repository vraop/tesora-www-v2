---
type Layer = {
  num: string;
  title: string;
  body: string;
  bullets?: string[];
};

export interface Props {
  eyebrow?: string;
  title?: string;
  caption?: string;
  intro?: string;
  layers: Layer[];
}

const { eyebrow, title, caption, intro, layers } = Astro.props;
---

<section class="ls" aria-label={title ?? "Tesora layered stack"} data-ls>
  <div class="ls-grid">
    <aside class="ls-aside">
      {eyebrow && <p class="ls-eyebrow">{eyebrow}</p>}
      {title && <h2 class="ls-title">{title}</h2>}
      {intro && <p class="ls-intro">{intro}</p>}
      {caption && <p class="ls-caption">{caption}</p>}
    </aside>

    <ol class="ls-track" role="list">
      {layers.map((l, i) => (
        <li class="ls-card" data-ls-card={i} style={`--i:${i}`}>
          <button class="ls-card__head" type="button" aria-expanded={i === 0 ? "true" : "false"}>
            <span class="ls-card__num">{l.num}</span>
            <span class="ls-card__main">
              <span class="ls-card__title">{l.title}</span>
              <span class="ls-card__body">{l.body}</span>
            </span>
            <span class="ls-card__count">{i + 1} / {layers.length}</span>
          </button>
          {l.bullets && l.bullets.length > 0 && (
            <div class="ls-card__bullets-wrap">
              <ul class="ls-card__bullets">
                {l.bullets.map((b) => (
                  <li>
                    <span class="ls-card__dot" aria-hidden="true"></span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .ls {
    --ls-accent: var(--color-oxblood, #B400FE);
    --ls-rule: var(--rule, rgba(14, 14, 12, 0.10));
    --ls-card: #FFFFFF;
    --ls-fg: var(--fg, #0E0E0C);
    --ls-muted: var(--fg-muted, #6B6760);
    --ls-sticky-top: 100px;
  }

  .ls-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    align-items: start;
  }

  .ls-aside {
    position: sticky;
    top: var(--ls-sticky-top);
    align-self: start;
    padding-top: 6px;
  }
  .ls-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ls-accent);
    margin: 0 0 12px;
  }
  .ls-title {
    margin: 0;
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.018em;
    color: var(--ls-fg);
  }
  .ls-intro {
    margin: 18px 0 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ls-muted);
    max-width: 460px;
  }
  .ls-caption {
    margin: 18px 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ls-muted);
  }

  .ls-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ls-card {
    position: relative;
    border: 1px solid var(--ls-rule);
    border-radius: 5px;
    background: var(--ls-card);
    overflow: hidden;
    transition: border-color 280ms ease, box-shadow 280ms ease, transform 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ls-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--ls-accent);
    opacity: 0;
    transition: opacity 220ms ease;
  }
  .ls-card.is-active {
    border-color: color-mix(in oklab, var(--ls-accent) 38%, var(--ls-rule));
    box-shadow:
      0 1px 0 rgba(14, 14, 12, 0.04),
      0 14px 30px -22px color-mix(in oklab, var(--ls-accent) 50%, transparent);
  }
  .ls-card.is-active::before {
    opacity: 1;
  }

  .ls-card__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 14px;
    width: 100%;
    padding: 14px 16px;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
  }
  .ls-card__num {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 26px;
    padding: 0 8px;
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: color-mix(in oklab, var(--ls-accent) 12%, transparent);
    color: var(--ls-accent);
    border: 1px solid color-mix(in oklab, var(--ls-accent) 24%, transparent);
  }
  .ls-card__main {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .ls-card__title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--ls-fg);
  }
  .ls-card__body {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ls-muted);
  }
  .ls-card__count {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ls-muted);
    padding-top: 5px;
  }

  .ls-card__bullets-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ls-card.is-active .ls-card__bullets-wrap {
    grid-template-rows: 1fr;
  }
  .ls-card__bullets {
    overflow: hidden;
    min-height: 0;
    list-style: none;
    margin: 0;
    padding: 0 16px 14px 62px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 6px 16px;
  }
  .ls-card__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ls-fg);
  }
  .ls-card__dot {
    margin-top: 7px;
    flex: 0 0 auto;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--ls-accent);
  }

  @media (max-width: 900px) {
    .ls-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .ls-aside {
      position: static;
    }
    .ls-card__bullets {
      padding-left: 16px;
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ls-card,
    .ls-card__bullets-wrap {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const sections = document.querySelectorAll<HTMLElement>("[data-ls]");
    if (!sections.length) return;

    for (const section of sections) {
      const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-ls-card]"));
      if (!cards.length) continue;

      const setActive = (idx: number) => {
        cards.forEach((c, i) => {
          c.classList.toggle("is-active", i === idx);
          const head = c.querySelector<HTMLButtonElement>(".ls-card__head");
          if (head) head.setAttribute("aria-expanded", i === idx ? "true" : "false");
        });
      };

      cards.forEach((card, i) => {
        const head = card.querySelector<HTMLButtonElement>(".ls-card__head");
        head?.addEventListener("click", () => {
          section.dataset.userPinned = String(i);
          setActive(i);
        });
      });

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          if (section.dataset.userPinned !== undefined) return;
          const viewportMid = window.innerHeight * 0.4;
          let activeIndex = 0;
          let bestDistance = Infinity;
          cards.forEach((card, i) => {
            const rect = card.getBoundingClientRect();
            const cardMid = rect.top + rect.height / 2;
            const distance = Math.abs(cardMid - viewportMid);
            if (rect.top < window.innerHeight && rect.bottom > 0 && distance < bestDistance) {
              bestDistance = distance;
              activeIndex = i;
            }
          });
          setActive(activeIndex);
        });
      };

      setActive(0);
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      onScroll();
    }
  })();
</script>
