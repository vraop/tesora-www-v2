---
// Dark glass agent-stack panel. Mirrors the Vulcan /government right-side card pattern.
// Use over a dark video band; the panel reads cleanly against motion.

type Step = { num: string; title: string; body: string };
type Output = { label: string };

export interface Props {
  eyebrow?: string;        // small caps line above title
  title: string;           // one-line bold workflow title
  agentChip?: string;      // optional small chip on the right ("Workbench + Audit")
  steps: Step[];           // 3–4 stacked sub-cards
  outputs?: Output[];      // bottom row of output chips
}

const { eyebrow = "Tesora agent stack", title, agentChip, steps, outputs = [] } = Astro.props;
---

<div class="agent-stack">
  <div class="agent-stack-head">
    <div class="agent-stack-head-text">
      <p class="agent-stack-eyebrow">{eyebrow}</p>
      <p class="agent-stack-title">{title}</p>
    </div>
    {agentChip && (
      <div class="agent-stack-chip">
        <p class="agent-stack-chip-eyebrow">Agent</p>
        <p class="agent-stack-chip-name">{agentChip}</p>
      </div>
    )}
  </div>

  <div class="agent-stack-steps">
    {steps.map((s) => (
      <div class="agent-stack-step">
        <div class="agent-stack-step-icon" aria-hidden="true">
          <span class="agent-stack-step-dot"></span>
        </div>
        <div class="agent-stack-step-text">
          <p class="agent-stack-step-title">{s.title}</p>
          <p class="agent-stack-step-body">{s.body}</p>
        </div>
        <p class="agent-stack-step-num">{s.num}</p>
      </div>
    ))}
  </div>

  {outputs.length > 0 && (
    <div class="agent-stack-outputs">
      {outputs.map((o) => (
        <div class="agent-stack-output">
          <span class="agent-stack-output-dot"></span>
          <p class="agent-stack-output-label">{o.label}</p>
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .agent-stack {
    /* Accent tint for the agent panel. Slight purple, distinct from the
       brand oxblood so the stack reads as the "compute layer". */
    --accent: #7c6cff;
    --oxblood: var(--accent);
    --bone: var(--color-bone, #faf7f0);
    --panel-bg: rgba(14, 14, 12, 0.88);
    --panel-border: rgba(250, 247, 240, 0.10);
    --panel-border-strong: rgba(250, 247, 240, 0.18);
    --panel-text: var(--bone);
    --panel-muted: rgba(250, 247, 240, 0.62);

    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: 5px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 24px 80px -32px rgba(0, 0, 0, 0.55);
    padding: 1.25rem;
    color: var(--panel-text);
    font-family: var(--font-sans, "Inter Tight", system-ui, sans-serif);
  }

  .agent-stack-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.25rem 0.25rem 1.125rem;
    border-bottom: 1px solid var(--panel-border);
  }
  .agent-stack-head-text { flex: 1; min-width: 0; }
  .agent-stack-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--panel-muted);
    margin: 0;
  }
  .agent-stack-title {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.005em;
    color: var(--panel-text);
  }

  .agent-stack-chip {
    flex-shrink: 0;
    text-align: right;
    border: 1px solid color-mix(in oklab, var(--oxblood) 38%, transparent);
    background: color-mix(in oklab, var(--oxblood) 14%, transparent);
    border-radius: 5px;
    padding: 0.375rem 0.625rem;
    min-width: 120px;
  }
  .agent-stack-chip-eyebrow {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--panel-muted);
  }
  .agent-stack-chip-name {
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: color-mix(in oklab, var(--oxblood) 75%, var(--bone));
    letter-spacing: -0.005em;
  }

  .agent-stack-steps {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding-top: 1rem;
  }
  .agent-stack-step {
    position: relative;
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 0.875rem;
    padding: 0.875rem;
    background: rgba(250, 247, 240, 0.025);
    border: 1px solid var(--panel-border);
    border-radius: 5px;
  }
  .agent-stack-step-icon {
    width: 36px;
    height: 36px;
    border-radius: 5px;
    background: color-mix(in oklab, var(--oxblood) 16%, transparent);
    border: 1px solid color-mix(in oklab, var(--oxblood) 32%, transparent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .agent-stack-step-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--oxblood) 85%, var(--bone));
  }
  .agent-stack-step-text { min-width: 0; }
  .agent-stack-step-title {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--panel-text);
  }
  .agent-stack-step-body {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--panel-muted);
  }
  .agent-stack-step-num {
    position: absolute;
    top: 0.625rem;
    right: 0.75rem;
    font-family: var(--font-mono, "JetBrains Mono", ui-monospace, monospace);
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--panel-muted);
  }

  .agent-stack-outputs {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .agent-stack-output {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.625rem 0.625rem 0.75rem;
    background: rgba(14, 14, 12, 0.55);
    border: 1px solid var(--panel-border);
    border-radius: 5px;
  }
  .agent-stack-output-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--oxblood) 80%, var(--bone));
  }
  .agent-stack-output-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.005em;
    color: var(--panel-text);
  }

  @media (max-width: 640px) {
    .agent-stack-outputs { grid-template-columns: 1fr; }
  }
</style>
