---
type Agent = {
  name: string;
  scope: string;
  href: string;
};

const agents: Agent[] = [
  {
    name: "Insight",
    scope: "Trending, on-leveling, GLMs, severity fits.",
    href: "/agents/insight",
  },
  {
    name: "Rating",
    scope: "Raters, factor tables, callable API.",
    href: "/agents/rating",
  },
  {
    name: "Audit",
    scope: "Regrades every analysis before the actuary sees it.",
    href: "#audit",
  },
  {
    name: "Reserving",
    scope: "Chain ladder, BF, Cape Cod on one triangle.",
    href: "/agents/reserving",
  },
];
---

<figure class="hd" aria-label="Diagram of the actuary orchestrating the Tesora Harness">
  <div class="hd-grid">
    {/* Actuary node on top */}
    <div class="hd-node hd-node--actuary">
      <span class="hd-node__tag">Actuary</span>
      <p class="hd-node__title">You</p>
      <p class="hd-node__sub">Sets the question. Signs the memo.</p>
    </div>

    {/* Connector spokes */}
    <svg class="hd-spokes" viewBox="0 0 600 220" aria-hidden="true" preserveAspectRatio="none">
      <path class="hd-spoke" d="M 300 18 C 300 80, 96 80, 96 178" />
      <path class="hd-spoke" d="M 300 18 C 300 80, 232 80, 232 178" />
      <path class="hd-spoke" d="M 300 18 C 300 80, 368 80, 368 178" />
      <path class="hd-spoke" d="M 300 18 C 300 80, 504 80, 504 178" />
    </svg>

    {/* Harness frame holding the agents */}
    <div class="hd-frame">
      <span class="hd-frame__tag">The Harness</span>
      <p class="hd-frame__rule">Citations, audit log, separation of duties — enforced.</p>
      <div class="hd-agents">
        {agents.map((a) => (
          <a class="hd-agent" href={a.href} aria-label={`${a.name} agent`}>
            <span class="hd-agent__name">{a.name}</span>
            <span class="hd-agent__kind">Agent</span>
            <p class="hd-agent__scope">{a.scope}</p>
          </a>
        ))}
      </div>
    </div>
  </div>

  <figcaption class="hd-caption">
    You orchestrate. The Harness keeps every agent on the same standards, the same data, the same audit log.
  </figcaption>
</figure>

<style>
  .hd {
    margin: 0;
    padding: 20px;
    border: 1px solid var(--rule);
    border-radius: 5px;
    background: var(--bg-panel, #fbfaf6);
  }

  .hd-grid {
    position: relative;
    display: grid;
    grid-template-rows: auto auto;
    gap: 0;
  }

  /* Actuary node */
  .hd-node {
    position: relative;
    z-index: 2;
    justify-self: center;
    text-align: center;
    width: min(280px, 60%);
    padding: 12px 16px 10px;
    border: 1px solid color-mix(in oklab, #B400FE 40%, var(--rule));
    border-radius: 5px;
    background: var(--bg, #ffffff);
  }
  .hd-node__tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-oxblood, #B400FE);
    padding: 2px 6px;
    border: 1px solid color-mix(in oklab, #B400FE 28%, transparent);
    border-radius: 5px;
    background: color-mix(in oklab, #B400FE 8%, transparent);
    margin-bottom: 6px;
  }
  .hd-node__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--fg, #1a1a1a);
  }
  .hd-node__sub {
    margin: 2px 0 0;
    font-size: 0.78125rem;
    color: var(--fg-muted, #6b6760);
    line-height: 1.4;
  }

  /* Spokes connecting actuary to agents */
  .hd-spokes {
    position: absolute;
    top: 56px;
    left: 0;
    right: 0;
    width: 100%;
    height: 120px;
    pointer-events: none;
    z-index: 1;
  }
  .hd-spoke {
    fill: none;
    stroke: color-mix(in oklab, #B400FE 38%, transparent);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  /* Harness frame */
  .hd-frame {
    position: relative;
    z-index: 2;
    margin-top: 96px;
    padding: 16px 14px 14px;
    border: 1.5px solid color-mix(in oklab, #B400FE 28%, var(--rule));
    border-radius: 5px;
    background: var(--bg, #ffffff);
  }
  .hd-frame__tag {
    position: absolute;
    top: -10px;
    left: 14px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-oxblood, #B400FE);
    background: var(--bg-panel, #fbfaf6);
    padding: 1px 8px;
    border: 1px solid color-mix(in oklab, #B400FE 28%, transparent);
    border-radius: 5px;
  }
  .hd-frame__rule {
    margin: 0 0 10px;
    font-size: 0.78125rem;
    color: var(--fg-muted, #6b6760);
    text-align: center;
    line-height: 1.4;
  }

  .hd-agents {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .hd-agent {
    display: block;
    border: 1px solid var(--rule);
    border-radius: 5px;
    padding: 10px 11px;
    background: var(--bg, #ffffff);
    color: inherit;
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease;
  }
  .hd-agent:hover {
    border-color: color-mix(in oklab, #B400FE 38%, var(--rule));
    transform: translateY(-1px);
  }
  .hd-agent__name {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--fg, #1a1a1a);
  }
  .hd-agent__kind {
    margin-left: 4px;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted, #888);
  }
  .hd-agent__scope {
    margin: 4px 0 0;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--fg-muted, #6b6760);
  }

  .hd-caption {
    margin-top: 14px;
    font-size: 0.78125rem;
    line-height: 1.45;
    color: var(--fg-muted, #6b6760);
    text-align: center;
  }

  @media (max-width: 900px) {
    .hd-agents {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hd-spokes { display: none; }
    .hd-frame { margin-top: 14px; }
  }
  @media (max-width: 520px) {
    .hd {
      padding: 14px;
    }
    .hd-agents {
      grid-template-columns: 1fr;
    }
  }
</style>
