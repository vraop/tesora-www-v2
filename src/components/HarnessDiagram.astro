---
type Agent = {
  name: string;
  scope: string;
  href: string;
};

const agents: Agent[] = [
  {
    name: "Insight",
    scope: "Trending, on-leveling, GLMs, severity fits.",
    href: "/agents/insight",
  },
  {
    name: "Rating",
    scope: "Raters, factor tables, callable API.",
    href: "/agents/rating",
  },
  {
    name: "Audit",
    scope: "Regrades every analysis before it ships.",
    href: "#audit",
  },
  {
    name: "Reserving",
    scope: "Chain ladder, BF, Cape Cod on one triangle.",
    href: "/agents/reserving",
  },
];
---

<figure class="hd" aria-label="Diagram of the Tesora Workbench wrapping the Harness" data-hd>
  <span class="hd-tag hd-tag--workbench" aria-hidden="true">Tesora Workbench</span>

  <div class="hd-inner">
    <span class="hd-tag hd-tag--harness" aria-hidden="true">The Harness</span>

    <svg class="hd-wires" viewBox="0 0 600 140" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <path id="hd-path-leg-0" d="M 300 0 L 300 35 L 75 35 L 75 140" />
        <path id="hd-path-leg-1" d="M 300 0 L 300 35 L 225 35 L 225 140" />
        <path id="hd-path-leg-2" d="M 300 0 L 300 35 L 375 35 L 375 140" />
        <path id="hd-path-leg-3" d="M 300 0 L 300 35 L 525 35 L 525 140" />
      </defs>

      <use class="hd-wire" href="#hd-path-leg-0" />
      <use class="hd-wire" href="#hd-path-leg-1" />
      <use class="hd-wire" href="#hd-path-leg-2" />
      <use class="hd-wire" href="#hd-path-leg-3" />

      <circle class="hd-node hd-node--top" cx="300" cy="0" r="4" />
      <circle class="hd-node" cx="75" cy="140" r="3.5" />
      <circle class="hd-node" cx="225" cy="140" r="3.5" />
      <circle class="hd-node" cx="375" cy="140" r="3.5" />
      <circle class="hd-node" cx="525" cy="140" r="3.5" />

      <g class="hd-pulses">
        <circle class="hd-pulse" r="3.2">
          <animateMotion dur="3.6s" begin="0s" repeatCount="indefinite" rotate="auto">
            <mpath href="#hd-path-leg-0" />
          </animateMotion>
        </circle>
        <circle class="hd-pulse hd-pulse--return" r="2.4">
          <animateMotion dur="3.6s" begin="1.8s" repeatCount="indefinite" rotate="auto" keyPoints="1;0" keyTimes="0;1" calcMode="linear">
            <mpath href="#hd-path-leg-0" />
          </animateMotion>
        </circle>

        <circle class="hd-pulse" r="3.2">
          <animateMotion dur="3.6s" begin="0.9s" repeatCount="indefinite" rotate="auto">
            <mpath href="#hd-path-leg-1" />
          </animateMotion>
        </circle>
        <circle class="hd-pulse hd-pulse--return" r="2.4">
          <animateMotion dur="3.6s" begin="2.7s" repeatCount="indefinite" rotate="auto" keyPoints="1;0" keyTimes="0;1" calcMode="linear">
            <mpath href="#hd-path-leg-1" />
          </animateMotion>
        </circle>

        <circle class="hd-pulse" r="3.2">
          <animateMotion dur="3.6s" begin="1.8s" repeatCount="indefinite" rotate="auto">
            <mpath href="#hd-path-leg-2" />
          </animateMotion>
        </circle>
        <circle class="hd-pulse hd-pulse--return" r="2.4">
          <animateMotion dur="3.6s" begin="3.6s" repeatCount="indefinite" rotate="auto" keyPoints="1;0" keyTimes="0;1" calcMode="linear">
            <mpath href="#hd-path-leg-2" />
          </animateMotion>
        </circle>

        <circle class="hd-pulse" r="3.2">
          <animateMotion dur="3.6s" begin="2.7s" repeatCount="indefinite" rotate="auto">
            <mpath href="#hd-path-leg-3" />
          </animateMotion>
        </circle>
        <circle class="hd-pulse hd-pulse--return" r="2.4">
          <animateMotion dur="3.6s" begin="4.5s" repeatCount="indefinite" rotate="auto" keyPoints="1;0" keyTimes="0;1" calcMode="linear">
            <mpath href="#hd-path-leg-3" />
          </animateMotion>
        </circle>
      </g>
    </svg>

    <ul class="hd-agents" role="list">
      {agents.map((a, i) => (
        <li class="hd-agent" style={`--i: ${i}`}>
          <a class="hd-agent__link" href={a.href} aria-label={`${a.name} agent`}>
            <span class="hd-agent__row">
              <span class="hd-agent__name">{a.name}</span>
              <span class="hd-agent__kind">Agent</span>
            </span>
            <p class="hd-agent__scope">{a.scope}</p>
          </a>
        </li>
      ))}
    </ul>

    <p class="hd-rule">Citations. Audit log. Separation of duties. Enforced.</p>
  </div>

  <figcaption class="hd-caption">
    The Workbench is the surface you work in. The Harness keeps every agent on the same standards, the same data, the same audit log.
  </figcaption>
</figure>

<style>
  .hd {
    --hd-accent: var(--color-oxblood, #B400FE);
    --hd-rule: var(--rule, rgba(14, 14, 12, 0.10));
    --hd-bg: var(--bg-panel, #E8E3D7);
    --hd-card: #FFFFFF;
    --hd-fg: var(--fg, #0E0E0C);
    --hd-muted: var(--fg-muted, #6B6760);
    position: relative;
    margin: 0;
    padding: 30px 22px 18px;
    border: 1.5px solid color-mix(in oklab, var(--hd-accent) 30%, var(--hd-rule));
    border-radius: 5px;
    background: var(--hd-card);
    box-shadow: 0 16px 40px -28px color-mix(in oklab, var(--hd-accent) 50%, transparent);
    display: flex;
    flex-direction: column;
  }

  .hd-tag {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 5px;
    z-index: 2;
  }
  .hd-tag--workbench {
    top: -11px;
    right: 22px;
    color: var(--hd-accent);
    background: var(--hd-card);
    border: 1px solid color-mix(in oklab, var(--hd-accent) 38%, transparent);
  }
  .hd-tag--harness {
    top: -10px;
    left: 22px;
    color: var(--hd-accent);
    background: var(--hd-bg);
    border: 1px solid color-mix(in oklab, var(--hd-accent) 30%, transparent);
  }

  .hd-inner {
    position: relative;
    padding: 22px 18px 16px;
    border: 1px dashed color-mix(in oklab, var(--hd-accent) 28%, var(--hd-rule));
    border-radius: 5px;
    background: var(--hd-bg);
    display: flex;
    flex-direction: column;
  }

  .hd-wires {
    display: block;
    width: 100%;
    height: 88px;
    margin: 4px 0 8px;
  }
  .hd-wire {
    fill: none;
    stroke: color-mix(in oklab, var(--hd-accent) 32%, transparent);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .hd-node {
    fill: var(--hd-accent);
    opacity: 0.85;
  }
  .hd-pulse {
    fill: var(--hd-accent);
    filter: drop-shadow(0 0 4px color-mix(in oklab, var(--hd-accent) 70%, transparent));
    opacity: 0.95;
  }
  .hd-pulse--return {
    fill: color-mix(in oklab, var(--hd-accent) 55%, white);
    opacity: 0.7;
  }

  .hd-agents {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    position: relative;
    z-index: 1;
  }
  .hd-agent {
    opacity: 0;
    transform: translateY(6px);
  }
  .hd.is-ready .hd-agent {
    animation: hd-rise 360ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: calc(160ms + var(--i, 0) * 80ms);
  }
  @keyframes hd-rise {
    to { opacity: 1; transform: translateY(0); }
  }
  .hd-agent__link {
    display: block;
    height: 100%;
    padding: 11px 12px 12px;
    border: 1px solid var(--hd-rule);
    border-radius: 5px;
    background: var(--hd-card);
    color: inherit;
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }
  .hd-agent__link:hover {
    border-color: color-mix(in oklab, var(--hd-accent) 40%, var(--hd-rule));
    transform: translateY(-1px);
    box-shadow: 0 6px 18px -14px color-mix(in oklab, var(--hd-accent) 35%, transparent);
  }
  .hd-agent__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }
  .hd-agent__name {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--hd-fg);
  }
  .hd-agent__kind {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hd-muted);
  }
  .hd-agent__scope {
    margin: 4px 0 0;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--hd-muted);
  }

  .hd-rule {
    margin: 16px 0 0;
    padding-top: 12px;
    border-top: 1px dashed var(--hd-rule);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hd-muted);
    text-align: center;
  }

  .hd-caption {
    margin-top: 14px;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--hd-muted);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .hd-agent { opacity: 1; transform: none; animation: none; }
    .hd-pulse { display: none; }
  }
  @media (max-width: 900px) {
    .hd-agents { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hd-wires { display: none; }
  }
  @media (max-width: 520px) {
    .hd { padding: 24px 16px 16px; }
    .hd-inner { padding: 18px 14px 14px; }
    .hd-agents { grid-template-columns: 1fr; }
  }
</style>

<script>
  const figures = document.querySelectorAll<HTMLElement>("[data-hd]");
  if (figures.length > 0 && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-ready");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    figures.forEach((f) => io.observe(f));
  } else {
    figures.forEach((f) => f.classList.add("is-ready"));
  }
</script>
