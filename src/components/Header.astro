---
import { u } from "../lib/url";
import { lifecycleStages } from "../data/lifecycle-stages";

export interface Props {
  variant?: "light" | "transparent";
}
const { variant = "light" } = Astro.props;

const agentsHref = u("/agents");

const agentsMenu = [
  {
    label: "Insight Agent",
    sub: "Loss modeling, trends, market research.",
    href: u("/agents/insight"),
  },
  {
    label: "Rating Agent",
    sub: "Base rates, factors, ILFs, pricing API.",
    href: u("/agents/rating"),
  },
];

const lifecycleMenu = lifecycleStages.map((s) => ({
  label: s.label,
  sub: s.seo.description.split(".")[0] + ".",
  href: u(`/agents/${s.id}`),
}));

const customersMenu = [
  {
    label: "Admitted carriers",
    sub: "Filing-driven raters with a full audit log.",
    href: u("/admitted"),
  },
  {
    label: "Non-admitted (E&S)",
    sub: "From data to deployed rater for E&S actuaries.",
    href: u("/non-admitted"),
  },
];

const companyMenu = [
  {
    label: "Careers",
    sub: "Engineering, actuarial, GTM.",
    href: u("/careers"),
  },
  {
    label: "Security",
    sub: "SOC 2, SOX-ready, ASOP-aligned.",
    href: u("/security"),
  },
  {
    label: "Media",
    sub: "Notes, announcements, and prior research.",
    href: u("/media"),
  },
];

const demoHref = "https://cal.com/team/tesora/quick-chat";
const loginHref = "https://app.tesora.ai";

// Floating-capsule nav. Pill-shaped, glass-blur, sits above all content.
// `transparent` = dark glass over a video hero. `light` = light glass over cream pages.
const capsuleBg =
  variant === "transparent"
    ? "bg-[var(--color-ink)]/45 border border-[var(--color-bone)]/15"
    : "bg-[var(--bg)]/75 border border-[var(--rule)]";
const textClass =
  variant === "transparent" ? "text-[var(--color-bone)]" : "text-[var(--fg)]";
const ctaClass = "btn-pill-purple";
const loginPillClass =
  variant === "transparent"
    ? "border border-[var(--color-bone)]/30 text-[var(--color-bone)] hover:border-[var(--color-bone)]/60 rounded-full px-4 py-1.5 text-sm font-medium tracking-tight transition-colors"
    : "border border-[var(--rule)] text-[var(--fg)] hover:border-[var(--fg)]/40 rounded-full px-4 py-1.5 text-sm font-medium tracking-tight transition-colors";
const toggleClass =
  variant === "transparent"
    ? "text-[var(--color-bone)] hover:opacity-75"
    : "text-[var(--fg)] hover:opacity-75";
const panelBgClass =
  variant === "transparent"
    ? "bg-[var(--color-ink)]/95 border border-[var(--color-bone)]/15"
    : "bg-[var(--bg)] border border-[var(--rule)]";
const panelTextClass =
  variant === "transparent" ? "text-[var(--color-bone)]" : "text-[var(--fg)]";
---

<header class="fixed top-0 left-0 right-0 z-50 pt-3 sm:pt-4 px-4 sm:px-6">
  <div class={`mx-auto max-w-[1180px] rounded-full ${capsuleBg} backdrop-blur-xl shadow-lg shadow-black/10`}>
    <div class={`flex justify-between items-center pl-5 pr-2 sm:pl-6 sm:pr-2.5 py-2 text-sm ${textClass}`}>
    <a href={u("/")} class="inline-flex items-center gap-2 font-semibold text-base tracking-tight">
      <img src={u("/logos/tesora.svg")} alt="Tesora" class="h-6 w-6" width="24" height="24" />
      <span>Tesora</span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      <div class="relative" data-menu>
        <button
          type="button"
          class="inline-flex items-center gap-1 hover:text-[var(--color-oxblood)] transition-colors"
          aria-haspopup="true"
          aria-expanded="false"
          data-menu-toggle
        >
          Agents
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <polyline points="2,4 5,7 8,4" />
          </svg>
        </button>
        <div
          class={`absolute left-0 top-full mt-3 w-[560px] p-3 ${panelBgClass} ${panelTextClass} shadow-xl rounded-[5px] hidden`}
          data-menu-panel
        >
          <div class="absolute inset-x-0 -top-3 h-3" aria-hidden="true"></div>
          <a
            href={agentsHref}
            class="block px-4 py-3 rounded-[5px] bg-[var(--color-oxblood)]/8 hover:bg-[var(--color-oxblood)]/14 group transition-colors mb-2"
          >
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="font-semibold text-[1.0625rem] leading-tight text-[var(--color-oxblood)]">
                  Agents for actuaries
                </p>
                <p class="mt-1 text-[0.8125rem] leading-snug text-[var(--fg-muted)]">
                  How the agents work, audited end to end.
                </p>
              </div>
              <span aria-hidden="true" class="text-[var(--color-oxblood)] text-base font-medium translate-x-0 group-hover:translate-x-0.5 transition-transform">→</span>
            </div>
          </a>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <p class="px-3 pt-1 pb-2 text-[0.6875rem] uppercase tracking-[0.18em] text-[var(--fg-muted)]">By agent</p>
              {agentsMenu.map((item) => (
                <a
                  href={item.href}
                  class="block px-3 py-2.5 rounded-[5px] hover:bg-[var(--color-oxblood)]/8 group transition-colors"
                >
                  <p class="font-semibold text-[0.9375rem] leading-tight group-hover:text-[var(--color-oxblood)] transition-colors">
                    {item.label}
                  </p>
                  <p class="mt-0.5 text-[0.8125rem] leading-snug text-[var(--fg-muted)]">
                    {item.sub}
                  </p>
                </a>
              ))}
            </div>
            <div>
              <p class="px-3 pt-1 pb-2 text-[0.6875rem] uppercase tracking-[0.18em] text-[var(--fg-muted)]">By lifecycle stage</p>
              {lifecycleMenu.map((item) => (
                <a
                  href={item.href}
                  class="block px-3 py-1.5 rounded-[5px] hover:bg-[var(--color-oxblood)]/8 group transition-colors"
                >
                  <p class="font-semibold text-[0.875rem] leading-tight group-hover:text-[var(--color-oxblood)] transition-colors">
                    {item.label}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="relative" data-menu>
        <button
          type="button"
          class="inline-flex items-center gap-1 hover:text-[var(--color-oxblood)] transition-colors"
          aria-haspopup="true"
          aria-expanded="false"
          data-menu-toggle
        >
          Customers
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <polyline points="2,4 5,7 8,4" />
          </svg>
        </button>
        <div
          class={`absolute left-0 top-full mt-3 w-[320px] p-2 ${panelBgClass} ${panelTextClass} shadow-xl rounded-[5px] hidden`}
          data-menu-panel
        >
          <div class="absolute inset-x-0 -top-3 h-3" aria-hidden="true"></div>
          {customersMenu.map((item) => (
            <a
              href={item.href}
              class="block px-3 py-2.5 rounded-[5px] hover:bg-[var(--color-oxblood)]/8 group transition-colors"
            >
              <p class="font-semibold text-[0.9375rem] leading-tight group-hover:text-[var(--color-oxblood)] transition-colors">
                {item.label}
              </p>
              <p class="mt-0.5 text-[0.8125rem] leading-snug text-[var(--fg-muted)]">
                {item.sub}
              </p>
            </a>
          ))}
        </div>
      </div>

      <div class="relative" data-menu>
        <button
          type="button"
          class="inline-flex items-center gap-1 hover:text-[var(--color-oxblood)] transition-colors"
          aria-haspopup="true"
          aria-expanded="false"
          data-menu-toggle
        >
          Company
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <polyline points="2,4 5,7 8,4" />
          </svg>
        </button>
        <div
          class={`absolute left-0 top-full mt-3 w-[320px] p-2 ${panelBgClass} ${panelTextClass} shadow-xl rounded-[5px] hidden`}
          data-menu-panel
        >
          <div class="absolute inset-x-0 -top-3 h-3" aria-hidden="true"></div>
          {companyMenu.map((item) => (
            <a
              href={item.href}
              class="block px-3 py-2.5 rounded-[5px] hover:bg-[var(--color-oxblood)]/8 group transition-colors"
            >
              <p class="font-semibold text-[0.9375rem] leading-tight group-hover:text-[var(--color-oxblood)] transition-colors">
                {item.label}
              </p>
              <p class="mt-0.5 text-[0.8125rem] leading-snug text-[var(--fg-muted)]">
                {item.sub}
              </p>
            </a>
          ))}
        </div>
      </div>
    </nav>

    <div class="flex items-center gap-4">
      <button
        type="button"
        id="theme-toggle"
        class={`hidden sm:inline-flex items-center justify-center h-8 w-8 rounded-full ${toggleClass}`}
        aria-label="Toggle dark mode"
      >
        <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <line x1="12" y1="2" x2="12" y2="4"/>
          <line x1="12" y1="20" x2="12" y2="22"/>
          <line x1="4.93" y1="4.93" x2="6.34" y2="6.34"/>
          <line x1="17.66" y1="17.66" x2="19.07" y2="19.07"/>
          <line x1="2" y1="12" x2="4" y2="12"/>
          <line x1="20" y1="12" x2="22" y2="12"/>
          <line x1="4.93" y1="19.07" x2="6.34" y2="17.66"/>
          <line x1="17.66" y1="6.34" x2="19.07" y2="4.93"/>
        </svg>
        <svg class="theme-icon-moon hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
        </svg>
      </button>
      <a href={loginHref} class={`hidden sm:inline-flex ${loginPillClass}`}>
        Log in
      </a>
      <a href={demoHref} class={`hidden sm:inline-flex ${ctaClass}`}>
        Demo →
      </a>
      <button
        type="button"
        id="mobile-nav-toggle"
        class={`md:hidden inline-flex items-center justify-center p-2 ${toggleClass}`}
        aria-label="Open menu"
        aria-controls="mobile-nav-panel"
        aria-expanded="false"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav-panel"
    class="md:hidden hidden mt-2 mx-4 sm:mx-6 rounded-[5px] border border-[var(--rule)] bg-[var(--bg)]/95 backdrop-blur-xl shadow-lg shadow-black/10"
  >
    <nav class="px-5 py-4 flex flex-col gap-1 text-base">
      <p class="text-xs uppercase tracking-[0.18em] text-[var(--fg-muted)]">Agents</p>
      <a href={agentsHref} class="block py-2 text-[var(--color-oxblood)] font-semibold">Agents for actuaries →</a>
      {agentsMenu.map((item) => (
        <a
          href={item.href}
          class="block py-2 text-[var(--fg)] hover:text-[var(--color-oxblood)] transition-colors"
        >
          {item.label}
        </a>
      ))}
      <p class="mt-3 text-xs uppercase tracking-[0.18em] text-[var(--fg-muted)]">Customers</p>
      {customersMenu.map((item) => (
        <a
          href={item.href}
          class="block py-2 text-[var(--fg)] hover:text-[var(--color-oxblood)] transition-colors"
        >
          {item.label}
        </a>
      ))}
      <p class="mt-3 text-xs uppercase tracking-[0.18em] text-[var(--fg-muted)]">Company</p>
      {companyMenu.map((item) => (
        <a
          href={item.href}
          class="block py-2 text-[var(--fg)] hover:text-[var(--color-oxblood)] transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a
        href={loginHref}
        class="block py-2 mt-3 text-[var(--fg)] hover:text-[var(--color-oxblood)] transition-colors"
      >
        Log in
      </a>
      <a
        href={demoHref}
        class="block py-2 text-[var(--color-oxblood)] font-medium"
      >
        Demo →
      </a>
      <button
        type="button"
        id="theme-toggle-mobile"
        class="mt-3 inline-flex items-center gap-2 py-2 text-sm text-[var(--fg-muted)] hover:text-[var(--fg)] transition-colors"
        aria-label="Toggle dark mode"
      >
        <span class="theme-icon-sun">☀︎</span>
        <span class="theme-icon-moon hidden">☾</span>
        <span class="theme-toggle-label">Switch to dark</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-nav-toggle");
  const panel = document.getElementById("mobile-nav-panel");
  if (btn && panel) {
    btn.addEventListener("click", () => {
      const open = panel.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    });
  }

  const menus = document.querySelectorAll<HTMLElement>("[data-menu]");
  const HOVER_CLOSE_MS = 220;
  const closers = new Map<HTMLElement, () => void>();

  menus.forEach((menu) => {
    const toggle = menu.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const dropdown = menu.querySelector<HTMLElement>("[data-menu-panel]");
    if (!toggle || !dropdown) return;

    let closeTimer: number | undefined;
    let pinned = false;

    const cancelClose = () => {
      if (closeTimer !== undefined) {
        window.clearTimeout(closeTimer);
        closeTimer = undefined;
      }
    };
    const open = () => {
      cancelClose();
      menus.forEach((other) => {
        if (other !== menu) closers.get(other)?.();
      });
      dropdown.classList.remove("hidden");
      toggle.setAttribute("aria-expanded", "true");
    };
    const closeNow = () => {
      cancelClose();
      pinned = false;
      dropdown.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
    };
    const scheduleClose = () => {
      if (pinned) return;
      cancelClose();
      closeTimer = window.setTimeout(closeNow, HOVER_CLOSE_MS);
    };

    closers.set(menu, closeNow);

    menu.addEventListener("mouseenter", () => { if (!pinned) open(); });
    menu.addEventListener("mouseleave", scheduleClose);
    toggle.addEventListener("click", (e) => {
      e.preventDefault();
      if (dropdown.classList.contains("hidden")) {
        pinned = true;
        open();
      } else if (pinned) {
        closeNow();
      } else {
        pinned = true;
      }
    });
    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node)) closeNow();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeNow();
    });
  });

  // Theme toggle. Persists to localStorage; respects system preference on first visit.
  const themeBtns = document.querySelectorAll<HTMLButtonElement>("#theme-toggle, #theme-toggle-mobile");
  const applyTheme = (mode: "light" | "dark") => {
    document.documentElement.setAttribute("data-theme", mode);
    document.querySelectorAll<HTMLElement>(".theme-icon-sun").forEach((el) => {
      el.classList.toggle("hidden", mode === "dark");
    });
    document.querySelectorAll<HTMLElement>(".theme-icon-moon").forEach((el) => {
      el.classList.toggle("hidden", mode === "light");
    });
    document.querySelectorAll<HTMLElement>(".theme-toggle-label").forEach((el) => {
      el.textContent = mode === "dark" ? "Switch to light" : "Switch to dark";
    });
  };
  const stored = localStorage.getItem("tesora-theme") as "light" | "dark" | null;
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
  const initial: "light" | "dark" = stored ?? (systemDark ? "dark" : "light");
  applyTheme(initial);
  themeBtns.forEach((b) => {
    b.addEventListener("click", () => {
      const next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
      localStorage.setItem("tesora-theme", next);
      applyTheme(next);
    });
  });
</script>
